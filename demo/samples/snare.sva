; Models: a snare drum, a pitched body under bandpassed rattle and a stick crack | Neglects: the wires' own modes | IO: (t) -> amplitude | Tags: drum
crop(0.8*tanh(2.4*(0.42*sin(2*pi*(185*t + 120*0.008*(1 - exp(-t/0.008))))*exp(-t/0.07) + 0.25*sin(2*pi*330*t)*exp(-t/0.04) + 1.7*bandpass(sample(rand(t, seed=11)), cutoff=2200, q=0.7)*(exp(-t/0.16) + 0.8*exp(-t/0.012)) + 1.0*highpass(sample(rand(t, seed=12)), cutoff=6000, q=0.7)*exp(-t/0.09) + 1.2*bandpass(sample(rand(t, seed=13)), cutoff=1300, q=1.2)*(exp(-t/0.006) + 0.6*step(t - 0.009)*exp(-(t - 0.009)/0.006) + 0.4*step(t - 0.019)*exp(-(t - 0.019)/0.008)))) + 0.13*lowpass(highpass(sample(rand(t, seed=14)), cutoff=900, q=0.7), cutoff=7000, q=0.7)*exp(-t/0.35), 0s, 0.9s, rise=0.0003s, fall=0.25s)
