; Models: a chip lead note, a narrow pulse with delayed vibrato | Neglects: the console's volume steps | IO: (t, f0, len) -> amplitude | Tags: lead
f0 = D5
len = 0.2
crop(0.35*(saw(f0, 0.012*f0/6*(1 - exp(-t/0.15))*sin(2*pi*6*t)) - saw(f0, 0.012*f0/6*(1 - exp(-t/0.15))*sin(2*pi*6*t) + 0.5*pi))*(0.75 + 0.25*exp(-t/0.05)), 0s, len, rise=0.002s, fall=0.015s)
