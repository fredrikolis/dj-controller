#!/usr/bin/env bash
# Concern: runs the per-commit gates | Non-concern: what any gate checks (the tools themselves), the attestation (git-agent-verdict) | IO: (the tree) -> exit 0, or the first gate's own failure

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
cargo clippy --workspace --all-targets --quiet -- -D warnings
cargo clippy -p dj-controller-model -p dj-controller-core -p dj-controller --target wasm32-unknown-unknown --all-targets --quiet -- -D warnings
cargo clippy -p dj-controller --target wasm32-unknown-unknown --all-targets --no-default-features --quiet -- -D warnings
cargo clippy -p dj-controller-model -p dj-controller-core -p dj-controller-cli --target x86_64-pc-windows-gnu --all-targets --quiet -- -D warnings
cargo clippy -p dj-controller-model -p dj-controller-core -p dj-controller-cli --target aarch64-apple-darwin --all-targets --quiet -- -D warnings
comment-crusher --config .comment-crusher.toml .
annotated-tree --strict-check --include-tests --hidden .
cargo test --workspace --quiet
npx -y -p typescript@5.9.3 tsc -p crates/dj-controller/twin
cargo run --quiet -p dj-controller-cli -- package target/pkg
test "$(node -p "require('./demo/package.json').dependencies['dj-controller']")" = "$(node -p "require('./target/pkg/package.json').version")"
npm --prefix demo ci --dry-run
npm pack --quiet --pack-destination target ./target/pkg
npm --prefix demo install --no-save "./target/dj-controller-$(node -p "require('./target/pkg/package.json').version").tgz"
npm --prefix demo run check && npm --prefix demo test
